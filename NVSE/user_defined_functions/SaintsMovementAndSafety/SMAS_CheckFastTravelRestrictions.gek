begin function {}

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMovementAndSafety\SMAS_GetConfigForFastTravel.gek"

	; Returns:
	;
	; 0: Allowed
	; 1: Health
	; 2: Limbs
	; 3: Radiation
	; 4: Hunger
	; 5: Thirst
	; 6: Sleep

	; Config

	array_var aConfig = Call GetConfigUDF

	short bDisableWithCrippledHead = aConfig["bDisableWithCrippledHead"]
	short bDisableWithCrippledTorso = aConfig["bDisableWithCrippledTorso"]
	short bDisableWithCrippledArms = aConfig["bDisableWithCrippledArms"]
	short bDisableWithCrippledLegs = aConfig["bDisableWithCrippledLegs"]
	short bDisableWhenWounded = aConfig["bDisableWhenWounded"]
	short bDisableWhenIrradiated = aConfig["bDisableWhenIrradiated"]
	short bDisableWhenStarving = aConfig["bDisableWhenStarving"]
	short bDisableWhenDehydrated = aConfig["bDisableWhenDehydrated"]
	short bDisableWhenSleepDeprived = aConfig["bDisableWhenSleepDeprived"]

	float fMinHealth = aConfig["fMinHealth"]
	float fMinRads = aConfig["fMinRads"]
	float fMinDehydration = aConfig["fMinDehydration"]
	float fMinHunger = aConfig["fMinHunger"]
	float fMinSleep = aConfig["fMinSleep"]

	let aConfig := Ar_Null

	; Health

	if eval (bDisableWhenWounded == 1) && (Player.GetHealthPercentage < fMinHealth)
		SetFunctionValue 1
		return
	endif

	; Limbs

	short bPlayerHasCrippledHead = Player.GetAV PerceptionCondition <= 0
	short bPlayerHasCrippledTorso = Player.GetAV EnduranceCondition <= 0
	short bPlayerHasCrippledArms = Player.GetAV LeftAttackCondition <= 0 || Player.GetAV RightAttackCondition <= 0
	short bPlayerHasCrippledLegs = Player.GetAV LeftMobilityCondition <= 0 || Player.GetAV RightMobilityCondition <= 0

	if eval (bDisableWithCrippledHead == 1) && (bPlayerHasCrippledHead == 1)
		SetFunctionValue 2
		return
	endif

	if eval (bDisableWithCrippledTorso == 1) && (bPlayerHasCrippledTorso == 1)
		SetFunctionValue 2
		return
	endif

	if eval (bDisableWithCrippledArms == 1) && (bPlayerHasCrippledArms == 1)
		SetFunctionValue 2
		return
	endif

	if eval (bDisableWithCrippledLegs == 1) && (bPlayerHasCrippledLegs == 1)
		SetFunctionValue 2
		return
	endif

	; Radiation

	if eval (bDisableWhenIrradiated == 1) && (Player.GetAV RadiationRads >= fMinRads)
		SetFunctionValue 3
		return
	endif

	; Hunger

	if eval (bDisableWhenStarving == 1) && (Player.GetAV Hunger >= fMinHunger)
		SetFunctionValue 4
		return
	endif

	; Thirst

	if eval (bDisableWhenDehydrated == 1) && (Player.GetAV Dehydration >= fMinDehydration)
		SetFunctionValue 5
		return
	endif

	; Sleep

	; Note: Actor value is called "SleepDeprevation" [sic] in engine.
	if eval (bDisableWhenSleepDeprived == 1) && (Player.GetAV SleepDeprevation >= fMinSleep)
		SetFunctionValue 6
		return
	endif

	SetFunctionValue 0

end