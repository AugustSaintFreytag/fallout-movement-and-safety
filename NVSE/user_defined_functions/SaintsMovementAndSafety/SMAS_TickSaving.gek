; Note: This script could use `ToggleDisableSaves` but it does not work from a script runner.
; The helper function `EnableSaves` provided by an already loaded plugin is used instead.

begin function {}

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMovementAndSafety\SMAS_GetConfigForSaving.gek"
	ref CheckTimeSinceLastEventUDF = CompileScript "SaintsMovementAndSafety\SMAS_CheckTimeSinceLastEvent.gek"
	ref MessageSaveStateChangeUDF = CompileScript "SaintsMovementAndSafety\SMAS_MessageSaveStateChange.gek"

	; Config

	array_var aConfig = Call GetConfigUDF

	short bDisableAnywhere = aConfig["bDisableAnywhere"]
	short bDisableInCombat = aConfig["bDisableInCombat"]

	short bEnableWhenSitting = aConfig["bEnableWhenSitting"]

	short bEnableNearFurniture = aConfig["bEnableNearFurniture"]
	float fFurnitureMaxDistance = aConfig["fFurnitureMaxDistance"]

	short bEnableAfterSleeping = aConfig["bEnableAfterSleeping"]
	float fSleepGraceGameTimeHours = aConfig["fSleepGraceGameTimeHours"]

	short bEnableAfterItem = aConfig["bEnableAfterItem"]
	float fItemGraceGameTimeHours = aConfig["fItemGraceGameTimeHours"]

	let aConfig := Ar_Null

	; Blocks

	ref SetEnableSavingFlagsUDF = (begin function {} 
		Player.AuxiliaryVariableSetFloat "*SMAS_bDidDisableSaving" 0
	end)

	ref EnableSavingUDF = (begin function {} 
		short bDidDisableSaving = Player.AuxiliaryVariableGetFloat "*SMAS_bDidDisableSaving"
		short bDidAllowTemporarySaving = Player.AuxiliaryVariableGetFloat "*SMAS_bDidAllowTemporarySaving"

		if eval !bDidDisableSaving
			return
		endif

		if eval bDidAllowTemporarySaving
			Call MessageSaveStateChangeUDF 1
		endif

		Call SetEnableSavingFlagsUDF
		Call EnableSaves 1
	end)

	ref SetDisableSavingFlagsUDF = (begin function {} 
		Player.AuxiliaryVariableSetFloat "*SMAS_bDidDisableSaving" 1
		Player.AuxiliaryVariableSetFloat "*SMAS_bDidAllowTemporarySaving" 0
	end)

	ref DisableSavingUDF = (begin function {}
		short bDidDisableSaving = Player.AuxiliaryVariableGetFloat "*SMAS_bDidDisableSaving"
		short bDidAllowTemporarySaving = Player.AuxiliaryVariableGetFloat "*SMAS_bDidAllowTemporarySaving"

		if eval bDidDisableSaving
			return
		endif

		if eval bDidAllowTemporarySaving
			Call MessageSaveStateChangeUDF 0
		endif

		Call SetDisableSavingFlagsUDF
		Call EnableSaves 0
	end)
	
	; Restriction (Combat)

	short iDetectionState = GetPCDetectionState
	short bIsInCombat = (iDetectionState == 3 || iDetectionState == 1)

	if eval (bDisableInCombat && bIsInCombat)
		Call DisableSavingUDF
		return
	endif

	; Permittance (Sleep)

	if eval bEnableAfterSleeping
		short bIsWithinGracePeriodForSleeping = (Call CheckTimeSinceLastEventUDF "*SMAS_fTimeLastSlept" fSleepGraceGameTimeHours)

		if bIsWithinGracePeriodForSleeping
			Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" 1
			Player.AuxiliaryVariableSetFloat "*SMAS_bDidAllowTemporarySaving" 1
			Call EnableSavingUDF
			return
		endif
	endif

	; Permittance (Item)

	if eval bEnableAfterItem
		short bIsWithinGracePeriodForItem = (Call CheckTimeSinceLastEventUDF "*SMAS_fTimeLastUsedItem" fItemGraceGameTimeHours)

		if bIsWithinGracePeriodForItem
			Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" 2
			Player.AuxiliaryVariableSetFloat "*SMAS_bDidAllowTemporarySaving" 1
			Call EnableSavingUDF
			return
		endif
	endif

	; Permittance (Furniture)

	if eval bEnableNearFurniture
		array_var aFurnitureObjects = GetRefs 39 1 1 fFurnitureMaxDistance
		short bIsNearSaveFurniture = 0

		foreach array_var aEntry <- aFurnitureObjects
			ref rFurniture = aEntry["value"]
			if eval !(HasKeyword rFurniture "SaveFurniture")
				continue
			endif

			if eval !(Player.HasOwnership rFurniture) && (rFurniture.GetOwner) && !(rFurniture.IsOwned Player)
				continue
			endif

			; Found matching furniture, allow.
			let bIsNearSaveFurniture := 1
			break
		loop

		if eval bIsNearSaveFurniture
			Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" 3
			Call EnableSavingUDF
			return
		endif
	endif

	; Permittance (Sitting)

	short bIsSitting = (Player.GetSitting == 3)

	if eval (bEnableWhenSitting && bIsSitting)
		Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" 4
		Call EnableSavingUDF
		return
	endif
	
	; Restriction (Anywhere)

	if eval bDisableAnywhere
		Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" 0
		Call DisableSavingUDF
		return
	endif

	; Enable

	Player.AuxiliaryVariableSetFloat "*_SMAS_iLastAllowedReason" (-1)
	Call EnableSavingUDF

end