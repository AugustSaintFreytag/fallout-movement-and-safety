begin function { ref rItem }

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMovementAndSafety\SMAS_GetConfigForSaving.gek"

	; Config
	
	array_var aConfig = (Call GetConfigUDF)
	short bEnableAfterItem = aConfig["bEnableAfterItem"]

	let aConfig := Ar_Null

	; Pre-Check

	if eval !bEnableAfterItem
		return
	endif

	if eval !(HasKeyword rItem "SaveItems")
		; PrintC "Player used non-registered save item '%z'." (GetName rItem)
		return
	endif

	; Run

	PrintC "Player used registered save item '%z'." (GetName rItem)

	float fCurrentTime = (GetGameDaysPassed 2282 2 10)
	Player.AuxiliaryVariableSetFloat "*SMAS_fTimeLastUsedItem" fCurrentTime

end