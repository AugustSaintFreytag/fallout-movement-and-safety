begin function { short iReason }

	; 0 = Grace period expired.
	; 1 = Grace period begins.
	; 2 = Object distance exceeded.
	; 3 = Object distance entered.

	if iReason == 0
		MessageExAlt 3 "#3|You are no longer able to save."
		return
	endif

	if iReason == 1
		MessageExAlt 3 "#1|You now have a chance to save."
		return
	endif

end